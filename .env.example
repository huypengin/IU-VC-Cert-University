# IU VC Issuer (Phase 2) - env example
#
# IMPORTANT: This is an issuer tool. The allowlisted keys below are bundled into the browser build
# (see `vite.config.ts`). Do not use production keys.

# VC contexts (required)
DEGREE_CONTEXT_URL="https://example.edu/contexts/iu-edu-degree-v1.jsonld"
IU_SMARTCERT_CONTEXT_URL="https://example.edu/contexts/iu-smartcert-v1.jsonld"
MERKLE_CONTEXT_URL="https://example.edu/contexts/merkle-receipt-v1.jsonld"

# VC issuer + schema (required)
ISSUER_DID="did:web:example.edu:issuers:iu"
ISSUER_NAME="International University"
SCHEMA_URL="https://example.edu/schemas/IUSmartCertUniversityCredential.json"

# Ed25519 signing key for DataIntegrityProof (required for signing)
# Encoding: hex string (32 bytes) OR base64 (32 bytes). Examples:
# - hex:    64 hex chars (no 0x prefix)
# - base64: 44 chars with '=' padding
ISSUER_ED25519_PRIVATE_KEY=""

# Chain anchoring (required only if you want to anchor on-chain)
CHAIN_ID="eip155:11155111"
RPC_URL="https://sepolia.infura.io/v3/YOUR_KEY"
CONTRACT_ADDRESS="0x0000000000000000000000000000000000000000"

# Wallet Pickup demo API base URL used by the UI.
# If omitted, UI falls back to BASE_URL (if defined) then http://localhost:8787.
# OID4VCI_BASE_URL="http://localhost:8787"

# OID4VCI + ngrok wrapper mode (for public wallet-reachable issuer URLs)
# Required for: npm run oid4vci:tunnel
# NGROK_DOMAIN="your-reserved-subdomain.ngrok-free.app"
# Optional if already configured globally via ngrok config:
# NGROK_AUTHTOKEN="your-ngrok-authtoken"

# OID4VCI server signing key (server-only, not injected into browser build)
# Use the ES256 private JWK that matches the registry DID document for the issuer.
# The `kid` should be the DID verification method ID, for example:
# did:web:infra-vc-registry-web-911368042037.asia-east2.run.app:issuers:principle#key-1
# OID4VCI_PRIVATE_JWK='{"kty":"EC","crv":"P-256","x":"...","y":"...","d":"...","use":"sig","alg":"ES256","kid":"did:web:infra-vc-registry-web-911368042037.asia-east2.run.app:issuers:principle#key-1"}'
