# IU VC Issuer (Phase 2) - env example
#
# IMPORTANT: This is an issuer tool. The allowlisted keys below are bundled into the browser build
# (see `vite.config.ts`). Do not use production keys.

# VC contexts (required)
DEGREE_CONTEXT_URL="https://example.edu/contexts/iu-edu-degree-v1.jsonld"
IU_SMARTCERT_CONTEXT_URL="https://example.edu/contexts/iu-smartcert-v1.jsonld"
MERKLE_CONTEXT_URL="https://example.edu/contexts/merkle-receipt-v1.jsonld"

# VC issuer + schema (required)
ISSUER_DID="did:web:example.edu:issuers:iu"
SCHEMA_URL="https://example.edu/schemas/IUSmartCertUniversityCredential.json"

# Ed25519 signing key for DataIntegrityProof (required for signing)
# Encoding: hex string (32 bytes) OR base64 (32 bytes). Examples:
# - hex:    64 hex chars (no 0x prefix)
# - base64: 44 chars with '=' padding
ISSUER_ED25519_PRIVATE_KEY=""

# Chain anchoring (required only if you want to anchor on-chain)
CHAIN_ID="eip155:11155111"
RPC_URL="https://sepolia.infura.io/v3/YOUR_KEY"
CONTRACT_ADDRESS="0x0000000000000000000000000000000000000000"
